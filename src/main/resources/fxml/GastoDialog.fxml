<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.apprenta.renta.controller.GastoDialogController"
      spacing="16" prefWidth="460">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label fx:id="lblTitulo" text="Nuevo gasto" styleClass="dialog-title"/>

    <GridPane hgap="12" vgap="12">
        <Label text="Fecha *"        GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpFecha"  GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Nº Factura *"        GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNumFactura"  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Proveedor *"       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtProveedor" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="NIF"          GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNif"  GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Opcional"/>

        <Label text="Categoría *"         GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbNaturaleza"    GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Base imponible *"  GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtBase"       GridPane.rowIndex="5" GridPane.columnIndex="1" promptText="0,00"/>

        <Label text="IVA"               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbPorcentajeIva" GridPane.rowIndex="6" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
    </GridPane>

    <!-- Totales calculados -->
    <VBox styleClass="card-info" spacing="6">
        <Label text="Calculado automáticamente:" styleClass="label-info-title"/>
        <HBox spacing="20">
            <Label text="Cuota IVA:"/>
            <Label fx:id="lblCuotaCalc" text="0,00 €" styleClass="label-bold"/>
            <Label text="Total:"/>
            <Label fx:id="lblTotalCalc" text="0,00 €" styleClass="label-bold"/>
        </HBox>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar" styleClass="btn-ghost"   onAction="#cancelar"/>
        <Button text="Guardar"  styleClass="btn-primary" onAction="#guardar"/>
    </HBox>
</VBox>

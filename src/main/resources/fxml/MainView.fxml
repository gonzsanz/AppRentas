<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.apprenta.renta.controller.MainController"
            stylesheets="@../css/main.css">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="200">
            <padding><Insets top="20" bottom="20"/></padding>

            <Label text="Gestión Autónomos" styleClass="sidebar-title"/>

            <VBox styleClass="nav-menu" VBox.vgrow="ALWAYS">
                <padding><Insets top="20"/></padding>
                <Button fx:id="btnInicio"       text="🏠  Inicio"            styleClass="nav-btn, nav-btn-active" maxWidth="Infinity" onAction="#navegarInicio"/>
                <Button fx:id="btnIngresos"     text="📈  Ingresos"          styleClass="nav-btn" maxWidth="Infinity" onAction="#navegarIngresos"/>
                <Button fx:id="btnGastos"       text="📉  Gastos"            styleClass="nav-btn" maxWidth="Infinity" onAction="#navegarGastos"/>
                <Button fx:id="btnModelo303"    text="📋  Modelo 303 (IVA)"  styleClass="nav-btn" maxWidth="Infinity" onAction="#navegarModelo303"/>
                <Button fx:id="btnModelo130"    text="📋  Modelo 130 (IRPF)" styleClass="nav-btn" maxWidth="Infinity" onAction="#navegarModelo130"/>
            </VBox>

            <Label fx:id="lblBBDD" text="Base de datos: autonomos.db" styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <!-- CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>
